NEXT_PUBLIC_API_URL=

# Only needed once a CDN custom domain replaces the raw storage host --
# see next.config.ts and the API's STORAGE_PUBLIC_BASE_URL.
NEXT_PUBLIC_MEDIA_HOSTNAME=

# Public site origin, e.g. https://example.ir -- used for canonical links and
# Google structured data. Leave empty in development.
NEXT_PUBLIC_SITE_URL=
