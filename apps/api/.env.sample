DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

PORT=
NODE_ENV=
WEB_ORIGIN=

SESSION_COOKIE_NAME=
SESSION_TTL_DAYS=

OTP_EXPIRY_MINUTES=
OTP_MAX_ATTEMPTS=
OTP_REQUEST_COOLDOWN_SECONDS=
OTP_HASH_SECRET=

# Real store name, used in the welcome SMS. Never fabricate this — leave
# empty in development until the real business name is confirmed.
STORE_NAME=

# ArvanCloud S3-compatible object storage -- required only when
# STORAGE_DRIVER=arvan.
ARVAN_S3_BUCKET=
ARVAN_S3_ENDPOINT=
ARVAN_S3_REGION=
ARVAN_S3_ACCESS_KEY=
ARVAN_S3_SECRET_KEY=

# "local" (default) writes to ./storage and serves it from /media -- see
# storage/local-disk-storage.provider.ts. "arvan" uses the ARVAN_S3_* vars
# above. STORAGE_PUBLIC_BASE_URL overrides the provider's default public
# URL (e.g. once a CDN custom domain exists) without any code/DB change.
STORAGE_DRIVER=
STORAGE_PUBLIC_BASE_URL=
UPLOAD_MAX_FILE_SIZE_MB=

ADMIN_LOGIN_MAX_ATTEMPTS=
ADMIN_LOGIN_LOCKOUT_MINUTES=

# Only read by `npm run admin:bootstrap` (src/database/seeds/admin.seed.ts)
# to create the first super_admin. Not read by the running app.
INITIAL_SUPER_ADMIN_PHONE=
INITIAL_SUPER_ADMIN_PASSWORD=

# AI shopping consultant (see src/ai). "mock" needs no external API key --
# it exercises the chat architecture without calling a real LLM. Switching
# to a real provider later is a config change, not a code change.
AI_PROVIDER=
AI_MAX_OUTPUT_TOKENS=
AI_MAX_PRODUCT_CANDIDATES=
AI_MAX_HISTORY_MESSAGES=
